{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Iniciar Codeon Ponto",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PORT": "3000"
      }
    },
    {
      "name": "Iniciar com recarga automatica",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.js",
      "runtimeArgs": ["--watch"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PORT": "3000"
      }
    }
  ]
}
