{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Codeon Ponto",
      "type": "shell",
      "command": "node src/server.js",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Iniciar com recarga automatica",
      "type": "shell",
      "command": "node --watch src/server.js",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Rodar testes",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": "test"
    },
    {
      "label": "Backup do banco",
      "type": "shell",
      "command": "node src/scripts/backup.js",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
